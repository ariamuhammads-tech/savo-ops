# SAVO Ops — environment example. Copy to .env.local and fill real values.
# Never commit .env.local (it is gitignored).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, never exposed to client

# App
NEXT_PUBLIC_APP_NAME=SAVO Ops
TZ=Asia/Jakarta

# (Deferred — leave blank for now)
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false

# Google Sheets sync (Apps Script Web App)
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_SYNC_TOKEN=

# Hades AI Engine (Primary: Groq Cloud ultra-fast / Secondary: Gemini)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Hades B2B Outbound Mailer (thesavorium@gmail.com)
# Generate Google App Password (16 huruf) di: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=thesavorium@gmail.com
SMTP_PASS=
SMTP_FROM="Savo Eats" <thesavorium@gmail.com>
